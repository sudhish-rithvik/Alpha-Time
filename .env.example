# ==========================================
# ALPHATIME ENVIRONMENT CONFIGURATION
# ==========================================

# Application
PROJECT_NAME="AlphaTime"
API_V1_STR="/api/v1"
SECRET_KEY="alphatime-super-secret-jwt-key-2026-institutional-trading"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local SQLite default (or PostgreSQL: postgresql://user:password@localhost:5432/alphatime)
DATABASE_URL="sqlite:///./alphatime.db"

# Market Data Provider: "auto", "yfinance", "mock"
DATA_PROVIDER="auto"

# AI / LLM Integration (Optional)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Entry Scoring Weights (Total must sum to 1.0)
WEIGHT_TECHNICAL=0.30
WEIGHT_SENTIMENT=0.20
WEIGHT_NEWS=0.20
WEIGHT_VOLUME=0.15
WEIGHT_HISTORICAL=0.15
